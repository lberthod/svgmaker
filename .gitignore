node_modules/
.svgmaker-tmp/
*.mp4
*.gif
!examples/**
.DS_Store

# Sorties générées des exemples (vidéos, voix, rendus) : recréées par build.sh / web.sh
examples/*/out/
examples/kids-english-th/videos/
examples/kids-english-th/web/
examples/*/web/
examples/*/build.log
examples/mali-english-th/mali.*
!examples/mali-english-th/mali.svg
examples/mali-english-th/mali-*.jpg
examples/mali-english-th/audio.wav
examples/mali-english-th/.svgmaker.json
examples/mali-english-th/svgmaker-audit.json

# Sorties des exemples de formats (svgmaker new / preview / render)
src/formats/*/examples/out/
__pycache__/

# Épisodes animés (cartoon-ecole, manga-combat, au-pied-de-la-lettre…) : seuls make.mjs,
# audio.py et les prises de voix voix/ sont versionnés ; le reste se régénère
examples/cartoon-ecole/*
!examples/cartoon-ecole/make.mjs
!examples/cartoon-ecole/audio.py
examples/manga-combat*/*
!examples/manga-combat*/make.mjs
!examples/manga-combat*/audio.py
!examples/manga-combat*/voix/
examples/au-pied-de-la-lettre-*/*
!examples/au-pied-de-la-lettre-*/make.mjs
!examples/au-pied-de-la-lettre-*/audio.py
examples/les-anomalies-*/*
!examples/les-anomalies-*/make.mjs
!examples/les-anomalies-*/audio.py
examples/les-anomalies/les-anomalies-saison1.mp4
# Roussin & Lino (renard-lapin) : seuls make.mjs, lib/, logo/ et les scripts sont versionnés
examples/renard-lapin/ep*/*
!examples/renard-lapin/ep*/make.mjs
examples/renard-lapin/reels/*.mp4
examples/renard-lapin/logo/.svgmaker.json

# Roussin & Lino, saisons 2+ : seuls make.mjs et les scripts sont versionnés
examples/renard-lapin/s[0-9]*/*/*
!examples/renard-lapin/s[0-9]*/*/make.mjs
examples/renard-lapin/sortie/
# Voix de référence : on garde la voix retenue, pas les candidates -1…-6
examples/renard-lapin/lib/voix-ref/*-[0-9].wav

# reels-nuit : rendus, audits, études et journaux régénérables
reels-nuit/**/audit/
reels-nuit/**/etude/
reels-nuit/**/briefs/out/
reels-nuit/logs/
reels-nuit/final/
reels-nuit/essais/
reels-nuit/**/*.mp4
reels-nuit/**/*.wav
*.log
